DATABASE_URL=postgresql://flowstate:flowstate@localhost:5432/flowstate
PORT=3001
# Required for Docker Compose; use a hex string: openssl rand -hex 24
FLOWSTATE_DB_PASSWORD=
# REQUIRED. Generate using: openssl rand -hex 32
# Configure on the server; enter the value in the dashboard at runtime.
FLOWSTATE_API_TOKEN=
# Optional paid AI model API. Leave blank for zero AI usage charges.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
